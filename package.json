{
  "name": "moonwitness-monorepo",
  "private": true,
  "version": "1.0.0-rc.1",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "bun --filter @moonwitness/ui build && node scripts/dev/run-local-services.mjs dev",
    "dev:api": "bun --filter @moonwitness/api dev",
    "dev:board": "bun --filter @moonwitness/board dev",
    "plan:lint": "plan-taskos lint",
    "plan:reindex": "plan-taskos reindex",
    "plan:next": "plan-taskos next",
    "plan:sync": "plan-taskos sync",
    "plan:mcp": "plan-taskos mcp",
    "start": "node scripts/dev/run-local-services.mjs start",
    "start:built": "node scripts/dev/run-local-services.mjs start:built",
    "reset:superadmin-password": "bun --filter @moonwitness/api reset:superadmin-password",
    "revoke:auth-sessions": "bun --filter @moonwitness/api revoke:auth-sessions",
    "attachments:reconcile": "bun --filter @moonwitness/api attachments:reconcile",
    "jobs:worker": "bun --filter @moonwitness/api jobs:worker",
    "jobs:scheduler": "bun --filter @moonwitness/api jobs:scheduler",
    "jobs:outbox": "bun --filter @moonwitness/api jobs:outbox",
    "db:migrate": "bun --filter @moonwitness/api db:migrate",
    "build": "node scripts/ci/build-workspace.mjs",
    "test": "bun run test:unit",
    "test:unit": "bun run build && bun run test:unit:built",
    "test:unit:ci": "node scripts/ci/run-unit-tests.mjs",
    "board:ui:check": "node scripts/ci/check-board-shared-ui.mjs",
    "ui:check": "bun run board:ui:check && bun run ui:design:check",
    "ui:design:check": "node scripts/ci/check-ui-design-system.mjs",
    "ui:design:audit": "node scripts/ci/check-ui-design-system.mjs --strict",
    "ui:design:report": "node scripts/ci/check-ui-design-system.mjs --json",
    "lint:ui": "bunx eslint packages/ui/src scripts/ci/check-ui-design-system.mjs && bun --filter @moonwitness/board lint",
    "api:addon:check": "node scripts/ci/check-api-addon-boundary.mjs",
    "agent:boundary:check": "node scripts/ci/check-addon-agent-boundary.mjs",
    "hooks:install": "node scripts/dev/setup-git-hooks.mjs",
    "prepare": "node -e \"import('node:fs').then(({existsSync})=>{if(existsSync('.git')&&existsSync('scripts/dev/setup-git-hooks.mjs')){return import('./scripts/dev/setup-git-hooks.mjs')}})\"",
    "test:ui": "bun --filter @moonwitness/ui build && node --test packages/ui/tests/*.test.mjs && node packages/ui/scripts/verify-package.mjs",
    "test:e2e:visual": "bunx --cwd apps/board playwright test e2e/visual-audit.spec.ts --config playwright.visual.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run build && bun --filter @moonwitness/board typecheck",
    "verify": "bun run node:parity --strict && bun run automation:check:secrets && bun run automation:check:action-pins && bun run automation:check:action-tags && bun run ui:check && bun run lint:ui && bun run lint && bun run format:check && bun run typecheck && bun run test:unit:built",
    "automation:check:action-pins": "node scripts/ci/check-action-pins.mjs",
    "automation:check:action-tags": "node scripts/ci/check-action-tag-pins.mjs",
    "automation:check:secrets": "node scripts/ci/check-gitleaks-config.mjs",
    "ci:affected": "node scripts/lib/select-affected.mjs",
    "preflight:fast": "node scripts/ci/preflight-fast.mjs",
    "node:parity": "node scripts/ci/check-node-version.mjs",
    "evolution:check": "node scripts/ci/check-constitution.mjs",
    "board:budget": "node scripts/ci/check-board-bundle.mjs",
    "test:unit:built": "bun --filter @moonwitness/types test && bunx --cwd apps/api vitest run --exclude tests/postgres.integration.test.ts --exclude tests/postgres.performance.integration.test.ts && bun --filter @moonwitness/auth test && bun --filter @moonwitness/client test && bun --filter @moonwitness/jobs test && bun --filter @moonwitness/logger test && bun --filter @moonwitness/orm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^17.2.4",
    "eslint": "^10.11.0",
    "jsdom": "^31.0.1",
    "knip": "^5.66.0",
    "prettier": "^3.9.9",
    "typescript": "~5.7.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "fast-jwt": "6.3.4",
    "ip-address": "^10.7.4",
    "objection": "3.1.5",
    "typescript": "~5.7.3"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "protobufjs"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": "24.x"
  }
}
