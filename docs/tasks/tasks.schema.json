{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moonwitness.org/schemas/moonwitness-tasks-v2.json",
  "title": "MoonWitness Smart TaskOS Contract v2",
  "description": "Canonical data contract for MoonWitness TaskOS, Second Brain, and execution control plane.",
  "type": "object",
  "required": ["schemaVersion", "format", "generatedAt", "projects", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["2.0.0"]
    },
    "format": {
      "type": "string",
      "enum": ["moonwitness-tasks/v2"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/project"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/task"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/document"
      }
    }
  },
  "definitions": {
    "project": {
      "type": "object",
      "required": ["slug", "name"],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "color": {
          "type": "string",
          "enum": ["gray", "red", "orange", "yellow", "green", "teal", "blue", "purple", "pink"]
        },
        "statuses": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "code",
        "project",
        "series",
        "title",
        "status",
        "priority",
        "sourceRef"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "Unique stable identifier across series (e.g., M0.01, K0-001, AUD-001, WA-P0-01, EVO-002, DSK-0.12)",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "project": {
          "type": "string"
        },
        "series": {
          "type": "string"
        },
        "milestone": {
          "type": ["string", "null"]
        },
        "horizon": {
          "type": ["string", "null"],
          "enum": ["now", "next", "later", "experiment", null]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "proposedSolution": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": ["bug", "security", "architecture", "performance", "dx", "product", "innovation", "documentation", "infrastructure", "governance", "research", "other"]
        },
        "type": {
          "type": "string",
          "enum": ["fix", "refactor", "feature", "research", "experiment", "infrastructure", "documentation", "other"]
        },
        "priority": {
          "type": "string",
          "enum": ["p0", "p1", "p2", "p3"]
        },
        "status": {
          "type": "string",
          "enum": ["backlog", "todo", "doing", "review", "blocked", "done"]
        },
        "human": {
          "type": "boolean"
        },
        "owner": {
          "type": ["string", "null"]
        },
        "assignee": {
          "type": ["string", "null"]
        },
        "risk": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", null]
        },
        "effort": {
          "type": ["string", "null"],
          "enum": ["xs", "s", "m", "l", "xl", null]
        },
        "scores": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "impact": { "type": "number", "minimum": 1, "maximum": 5 },
            "confidence": { "type": "number", "minimum": 1, "maximum": 5 },
            "strategicValue": { "type": "number", "minimum": 1, "maximum": 5 },
            "effort": { "type": "number", "minimum": 1, "maximum": 5 },
            "priorityScore": { "type": "number" }
          }
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "packages": { "type": "array", "items": { "type": "string" } },
            "files": { "type": "array", "items": { "type": "string" } }
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "done"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "done": { "type": "boolean" }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commands": { "type": "array", "items": { "type": "string" } },
            "expected": { "type": "string" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": { "type": "array", "items": { "type": "string" } },
            "detailFile": { "type": ["string", "null"] },
            "commitSha": { "type": ["string", "null"] }
          }
        },
        "references": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blockedReason": {
          "type": ["string", "null"]
        },
        "sourceRef": {
          "type": "object",
          "required": ["file"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "legacyId": { "type": ["string", "null"] }
          }
        },
        "url": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "description": "Lossless source-specific fields retained for delegated work-package projections. Canonical lifecycle fields remain at the TaskOS task root."
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["author", "body", "createdAt"],
            "additionalProperties": false,
            "properties": {
              "author": { "type": "string" },
              "body": { "type": "string" },
              "createdAt": { "type": "string" }
            }
          }
        }
      }
    },
    "document": {
      "type": "object",
      "required": ["slug", "layer", "title", "body"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string" },
        "layer": {
          "type": "string",
          "enum": ["raw", "brain", "wiki", "blueprints", "specs"]
        },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "project": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["draft", "in_review", "accepted", "implemented", "superseded", "archived"]
        },
        "linkedTasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}
