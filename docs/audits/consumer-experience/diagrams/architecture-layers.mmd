flowchart TB
  subgraph Consumers["Consumer Applications"]
    Board["apps/board (@moonwitness/board)<br/>product-adopter · Next.js 16 App Router"]
    Desktop["apps/desktop (@moonwitness/desktop)<br/>product-adopter · Tauri v2 + Vite Webview"]
    Catalog["apps/ui-catalog (@moonwitness/ui-catalog)<br/>reference-consumer · Vite 8 Showcase"]
    Docs["apps/docs (@moonwitness/docs)<br/>publication-shell · Vite 8 Portal"]
    Obs["apps/agent-observability<br/>standalone-exempt · Read-only"]
  end

  subgraph SharedUI["Shared Design System & Asset Packages"]
    UI["@moonwitness/ui<br/>48 components · 88 icons · 3 skins · tokens.css"]
    Assets["@moonwitness/assets<br/>251 manifest assets · fonts.css · SVG/WebP/SFX"]
    Types["@moonwitness/types<br/>DTOs · SkinMetadata · ColorMode · Contracts"]
  end

  subgraph ClientTransport["Client SDK, BFF & Desktop Bridge"]
    Client["@moonwitness/client<br/>MoonWitnessClient · Auth & Model CRUD"]
