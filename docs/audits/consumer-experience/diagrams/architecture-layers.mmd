    Bridge["DesktopCapabilityBridge<br/>window.__MW_DESKTOP__ · R0-R4 Risk Gate"]
    Sidecar["Desktop Local Sidecar<br/>127.0.0.1:4242 · Fastify 5 + SQLite WAL"]
  end

  subgraph DomainHosts["Backend Hosts & Domain Addons (non-ui)"]
    API["apps/api (@moonwitness/api)<br/>non-ui · Fastify 5 Thin Host"]
    Sandbox["apps/agent-sandbox<br/>non-ui · Isolated Execution"]
    ISP["apps/isp (@moonwitness/isp)<br/>non-ui · Rust/RADIUS Host"]
    CP["apps/control-plane<br/>non-ui · Go Control Plane"]
    ORM["@moonwitness/orm + 35 orm-* addons<br/>INV-014 manifest.httpPlugins"]
    Runtime["@moonwitness/ai-runtime · ai-mcp · local-ai<br/>PCW · Visual DNA · Orbit Auditors"]
  end

  subgraph Governance["Static Governance & Budget Gates"]
    G1["scripts/check-board-shared-ui.mjs<br/>App classification & raw JSX/SVG guard"]
    G2["scripts/check-ui-design-system.mjs<br/>Token, literal color & 23-item debt ratchet"]
    G3["scripts/check-desktop-non-overlap.mjs<br/>INV-009 zero-overlap membrane"]
    G4["scripts/check-board-bundle.mjs &<br/>scripts/check-ui-catalog-budget.mjs"]
  end

