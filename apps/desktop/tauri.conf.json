{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoonWitness Desktop",
  "version": "1.0.0-rc.1",
  "identifier": "com.moonwitness.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @moonwitness/board dev",
    "devUrl": "http://127.0.0.1:5173/board",
    "beforeBuildCommand": "pnpm --filter @moonwitness/board build",
    "frontendDist": "../board/.next/standalone/apps/board"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MoonWitness Desktop",
        "url": "/board",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:"],
        "font-src": ["'self'", "data:"],
        "connect-src": [
          "'self'",
          "http://127.0.0.1:3000",
          "http://127.0.0.1:5173",
          "http://127.0.0.1:11434",
          "http://localhost:3000",
          "http://localhost:5173",
          "http://localhost:11434",
          "ws://127.0.0.1:5173",
          "ws://localhost:5173",
          "ipc:",
          "http://ipc.localhost"
        ],
        "frame-ancestors": ["'none'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:"],
        "font-src": ["'self'", "data:"],
        "connect-src": [
          "'self'",
          "http://127.0.0.1:3000",
          "http://127.0.0.1:5173",
          "http://127.0.0.1:11434",
          "http://localhost:3000",
          "http://localhost:5173",
          "http://localhost:11434",
          "ws://127.0.0.1:5173",
          "ws://localhost:5173",
          "ipc:",
          "http://ipc.localhost"
        ],
        "frame-ancestors": ["'none'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["../board/public/brand/app-icon-192.png", "../board/public/brand/app-icon-512.png"],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "certificateThumbprint": null,
      "signCommand": null
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
