{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../board/src/*"],
      "next/link": ["./desktop-web/shims/next-link.tsx"],
      "next/navigation": ["./desktop-web/shims/next-navigation.ts"],
      "next/image": ["./desktop-web/shims/next-image.tsx"],
      "next/dynamic": ["./desktop-web/shims/next-dynamic.tsx"],
      "react": ["../board/node_modules/@types/react"],
      "react/jsx-runtime": ["../board/node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["../board/node_modules/@types/react/jsx-dev-runtime"],
      "react-dom": ["../board/node_modules/@types/react-dom"],
      "react-dom/client": ["../board/node_modules/@types/react-dom/client"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["desktop-web/**/*.ts", "desktop-web/**/*.tsx"],
  "exclude": ["node_modules", "dist", "dist-board"]
}
