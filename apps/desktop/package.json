{
  "name": "@moonwitness/desktop",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Local-first MoonWitness desktop agent harness and Tauri v2 host bridge derived from apps/board",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tauri.conf.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@moonwitness/orm": "workspace:*",
    "@moonwitness/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "~5.7.3",
    "vitest": "^5.0.3"
  }
}
