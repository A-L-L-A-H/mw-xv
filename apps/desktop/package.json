{
  "name": "@moonwitness/desktop",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Local-first MoonWitness desktop agent harness and Tauri v2 host bridge derived from apps/board",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "moonwitness-desktop": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "tauri.conf.json"
  ],
  "scripts": {
    "build": "tsc",
    "build:web": "vite build --config desktop-web/vite.config.ts",
    "test": "vitest run",
    "test:web": "playwright test --config playwright.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@moonwitness/ai-mcp": "workspace:*",
    "@moonwitness/ai-runtime": "workspace:*",
    "@moonwitness/client": "workspace:*",
    "@moonwitness/jobs": "workspace:*",
    "@moonwitness/logger": "workspace:*",
    "@moonwitness/orm": "workspace:*",
    "@moonwitness/orm-ai": "workspace:*",
    "@moonwitness/orm-base": "workspace:*",
    "@moonwitness/orm-cloud": "workspace:*",
    "@moonwitness/orm-knowledge": "workspace:*",
    "@moonwitness/orm-notification": "workspace:*",
    "@moonwitness/orm-organization": "workspace:*",
    "@moonwitness/orm-project": "workspace:*",
    "@moonwitness/orm-storage": "workspace:*",
    "@moonwitness/orm-workflow": "workspace:*",
    "@moonwitness/types": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "knex": "^3.3.0",
    "objection": "^3.1.5"
  },
  "devDependencies": {
    "@moonwitness/assets": "workspace:*",
    "@moonwitness/ui": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "cmdk": "^1.1.1",
    "motion": "^13.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~5.7.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
