{
  "name": "@moonwitness/whatsapp",
  "version": "1.0.0-rc.1",
  "description": "Standalone MoonWitness WhatsApp gateway service with @fastify/vite React UI, @moonwitness/orm REST API, and native Baileys driver",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "vite build && tsc",
    "start": "node dist/server.js",
    "test": "tsc -p tsconfig.check.json && vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/sensible": "^6.0.6",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/vite": "^10.0.0",
    "@moonwitness/assets": "workspace:*",
    "@moonwitness/logger": "workspace:*",
    "@moonwitness/orm": "workspace:*",
    "@moonwitness/orm-base": "workspace:*",
    "@moonwitness/orm-whatsapp": "workspace:*",
    "@moonwitness/types": "workspace:*",
    "@moonwitness/ui": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "fastify": "^5.12.8",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vitest": "5.0.3"
  }
}
