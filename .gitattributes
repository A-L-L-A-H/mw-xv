*.go text eol=lf
apps/ui-catalog/tests/catalog.spec.ts-snapshots/*.txt text eol=lf
# Corpus bytes are content-addressed; an eol filter would break every pinned digest.
corpus/** -text
# The docs generator emits LF and its checker compares raw bytes, so these must check out as LF everywhere.
docs/guide/reference/** text eol=lf
# TaskOS sweep-and-consolidate --check compares raw bytes against an LF projection.
docs/tasks/tasks.json text eol=lf
# Pinned third-party snapshots and raw source art are not reviewable first-party code.
vendor/** linguist-vendored
raw_arts/** linguist-generated
# Immutable Visual Universe task-card archive is golden data, not hand-edited source.
docs/bundles/visual-universe-pack/legacy/** linguist-generated
