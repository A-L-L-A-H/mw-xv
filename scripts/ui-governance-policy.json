  "knip": {
    "mode": "reviewed-ratchet",
    "command": "pnpm exec knip --no-exit-code --no-progress",
    "deleteUnusedPublicApis": false,
    "protectedPublicApis": [
      {
        "subpath": "./components/kanban-board",
        "export": "KanbanBoard",
        "reason": "Public presentational API retained even when monorepo usage is absent."
      },
      {
        "subpath": "./components/filter-facet-bar",
        "export": "FilterFacetBar",
        "reason": "Public presentational API retained even when monorepo usage is absent."
      }
    ]
  },
  "aliasCanonicalization": {
    "legacyPrefix": "--ink",
    "canonicalPrefix": "--mw-",
    "enforcement": "report-only",
    "strictFlag": "--strict-alias-debt",
    "reason": "Package source is outside the Phase 6 script ownership boundary; integration must update it."
  },
  "independentChecks": {
    "apps/docs": [
      {
        "name": "docs-publication",
        "command": "pnpm docs:publication:check",
        "artifact": "apps/docs/dist"
