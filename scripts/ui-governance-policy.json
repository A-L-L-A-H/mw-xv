{
  "version": 1,
  "apps": {
    "apps/board": {
      "packageName": "@moonwitness/board",
      "classification": "product-adopter",
      "browser": true,
      "sourceRoots": ["src"],
      "publicRoots": ["public"],
      "sharedSourceRoots": [],
      "routeRoots": ["src/app"],
      "entryFiles": [],
      "aliases": {
        "@": "apps/board/src"
      },
      "generatedAssets": [
        "public/animation/**",
        "public/brand/**",
        "public/environments/**",
        "public/favicon.svg",
        "public/fonts/**",
        "public/illustrations/**",
        "public/materials/**",
        "public/scenes/**"
      ],
      "runtimeEvidence": [
        {
          "name": "board-resilience",
          "kind": "browser",
          "command": "pnpm test:e2e",
          "tests": ["apps/board/e2e/resilience.spec.ts"],
          "enforcement": "separate-ci-lane"
        },
        {
          "name": "board-visual",
          "kind": "browser",
          "command": "pnpm test:e2e:visual:matrix",
          "tests": ["apps/board/e2e/visual-audit.spec.ts"],
          "enforcement": "separate-ci-lane"
        }
      ]
    },
    "apps/desktop": {
      "packageName": "@moonwitness/desktop",
      "classification": "product-adopter",
      "browser": true,
      "sourceRoots": ["desktop-web"],
      "publicRoots": [],
      "sharedSourceRoots": ["apps/board/src"],
      "routeRoots": [],
      "entryFiles": ["desktop-web/main.tsx"],
      "aliases": {
        "@": "apps/board/src"
      },
      "generatedAssets": [],
      "runtimeEvidence": [
        {
          "name": "desktop-webview",
          "kind": "browser",
          "command": "pnpm desktop:test:web",
          "tests": ["apps/desktop/desktop-web/tests/routes.spec.ts"],
          "enforcement": "separate-ci-lane"
        }
      ]
    },
    "apps/ui-catalog": {
      "packageName": "@moonwitness/ui-catalog",
      "classification": "reference-consumer",
      "browser": true,
      "sourceRoots": ["src"],
      "publicRoots": ["public"],
      "sharedSourceRoots": [],
      "routeRoots": [],
      "entryFiles": ["src/main.tsx"],
      "aliases": {},
      "generatedAssets": ["public/generated/**"],
      "runtimeEvidence": [
        {
          "name": "catalog-browser",
          "kind": "browser",
          "command": "pnpm test:ui-catalog",
          "tests": ["apps/ui-catalog/tests/catalog.spec.ts"],
          "enforcement": "separate-ci-lane"
        },
        {
          "name": "catalog-budget",
          "kind": "bundle",
          "command": "pnpm test:ui-budget",
          "tests": ["apps/ui-catalog/tests/bundle-budget.test.mjs"],
          "enforcement": "separate-ci-lane"
        }
      ]
    },
    "apps/agent-observability": {
      "packageName": "@moonwitness/agent-observability",
      "classification": "standalone-exempt",
      "browser": true,
      "sourceRoots": [],
      "publicRoots": ["public"],
      "sharedSourceRoots": [],
      "routeRoots": [],
      "entryFiles": [],
      "aliases": {},
      "generatedAssets": [],
      "runtimeEvidence": []
    },
    "apps/agent-sandbox": {
      "packageName": "@moonwitness/agent-sandbox",
      "classification": "non-ui",
      "browser": false,
      "sourceRoots": [],
      "publicRoots": [],
      "sharedSourceRoots": [],
      "routeRoots": [],
      "entryFiles": [],
      "aliases": {},
      "generatedAssets": [],
      "runtimeEvidence": []
    },
    "apps/api": {
      "packageName": "@moonwitness/api",
      "classification": "non-ui",
      "browser": false,
      "sourceRoots": [],
      "publicRoots": [],
      "sharedSourceRoots": [],
      "routeRoots": [],
      "entryFiles": [],
      "aliases": {},
      "generatedAssets": [],
      "runtimeEvidence": []
    },
    "apps/isp": {
      "packageName": "@moonwitness/isp",
      "classification": "non-ui",
      "browser": false,
      "sourceRoots": [],
      "publicRoots": [],
      "sharedSourceRoots": [],
      "routeRoots": [],
      "entryFiles": [],
      "aliases": {},
      "generatedAssets": [],
      "runtimeEvidence": []
    },
    "apps/control-plane": {
      "packageName": "@moonwitness/control-plane",
      "classification": "non-ui",
      "browser": false,
      "sourceRoots": [],
      "publicRoots": [],
      "sharedSourceRoots": [],
      "routeRoots": [],
      "entryFiles": [],
      "aliases": {},
      "generatedAssets": [],
      "runtimeEvidence": []
    },
    "apps/whatsapp": {
      "packageName": "@moonwitness/whatsapp",
      "classification": "standalone-exempt",
      "browser": true,
      "sourceRoots": ["client"],
      "publicRoots": [],
      "sharedSourceRoots": [],
      "routeRoots": [],
      "entryFiles": ["client/main.tsx"],
      "aliases": {},
      "generatedAssets": [],
      "runtimeEvidence": []
    }
  },
  "rules": {
    "sharedChildClassOverrides": {
      "mode": "reviewed-debt-ratchet",
      "reviewedDebt": []
    }
  },
  "knip": {
    "mode": "reviewed-ratchet",
    "command": "pnpm exec knip --no-exit-code --no-progress",
    "deleteUnusedPublicApis": false,
    "protectedPublicApis": [
      {
        "subpath": "./components/kanban-board",
        "export": "KanbanBoard",
        "reason": "Public presentational API retained even when monorepo usage is absent."
      },
      {
        "subpath": "./components/filter-facet-bar",
        "export": "FilterFacetBar",
        "reason": "Public presentational API retained even when monorepo usage is absent."
      }
    ]
  },
  "aliasCanonicalization": {
    "legacyPrefix": "--ink",
    "canonicalPrefix": "--mw-",
    "enforcement": "error",
    "strictFlag": "--strict-alias-debt",
    "reason": "Package source is outside the Phase 6 script ownership boundary; integration must update it."
  },
  "independentChecks": {
    "apps/agent-observability": [
      {
        "name": "observability-tests",
        "command": "pnpm --filter @moonwitness/agent-observability test"
      }
    ]
  }
}
