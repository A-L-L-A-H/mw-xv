{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoonWitness Visual Universe Task Plan",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "repository",
    "tasks",
    "execution_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "repository": {
      "type": "object"
    },
    "workspace_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_addons": {
      "type": "array"
    },
    "phase_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_policy": {
      "type": "object"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "task_count": {
      "type": "integer"
    },
    "definition_of_done": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "phase",
        "title",
        "status",
        "depends_on",
        "objective",
        "deliverables",
        "acceptance_criteria",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "todo",
            "in_progress",
            "blocked",
            "done",
            "skipped"
          ]
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "role": {
          "type": "string"
        },
        "parallel_group": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objective": {
          "type": "string"
        },
        "scope_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "type": "string"
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "evidence": {
          "type": "array"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
