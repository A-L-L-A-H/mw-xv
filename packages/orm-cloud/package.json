{
  "name": "@moonwitness/orm-cloud",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Cloud Deployment addon for MoonWitness ORM",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.check.json && vitest run"
  },
  "dependencies": {
    "@moonwitness/jobs": "workspace:*",
    "@moonwitness/orm": "workspace:*",
    "@moonwitness/orm-base": "workspace:*",
    "@moonwitness/orm-project": "workspace:*",
    "@moonwitness/orm-subscription": "workspace:*",
    "@moonwitness/types": "workspace:*",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@moonwitness/orm-crm": "workspace:*",
    "@moonwitness/orm-notification": "workspace:*",
    "@moonwitness/orm-organization": "workspace:*",
    "@moonwitness/orm-sales": "workspace:*",
    "@moonwitness/orm-storage": "workspace:*",
    "@moonwitness/orm-workflow": "workspace:*",
    "@vitest/coverage-v8": "5.0.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.6",
    "knex": "^3.3.0",
    "typescript": "~5.7.3",
    "vitest": "^5.0.3"
  }
