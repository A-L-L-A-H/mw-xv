{
  "name": "@moonwitness/orm-project",
  "version": "1.0.0-rc.1",
  "description": "Company-scoped project, stage, milestone, task, and dependency addon integrating organization, workflow, notification, AI work contracts, and local TaskOS",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
