{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/schemas/plan-taskos/document.schema.json",
  "title": "PlanTaskOS Document",
  "type": "object",
  "required": ["urn", "slug", "layer", "title", "path", "status"],
  "additionalProperties": false,
  "properties": {
    "urn": {
      "type": "string",
      "pattern": "^urn:mw:doc:"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "string",
      "enum": ["raw", "brain", "wiki", "blueprints", "specs"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in_review", "accepted", "implemented", "superseded", "archived"]
    },
    "linked_task_urns": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:mw:work:"
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
