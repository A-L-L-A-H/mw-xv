{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.org/schemas/plan-taskos/proof.schema.json",
  "title": "PlanTaskOS Proof Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "task_urn",
    "code",
    "parent_proof_hashes",
    "commands",
    "diff_files",
    "owner_files_verified",
    "acceptance_criteria_state",
    "commit_sha",
    "model_tier",
    "agent_runtime",
    "verified_at",
    "envelope_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "task_urn": {
      "type": "string",
      "pattern": "^urn:mw:work:"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
    },
    "parent_proof_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cmd",
          "exit_code",
          "duration_ms",
          "stdout_sha256",
          "stderr_sha256",
          "redacted_excerpt"
        ],
        "additionalProperties": false,
        "properties": {
          "cmd": { "type": "string", "minLength": 1 },
          "exit_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "redacted_excerpt": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "diff_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "owner_files_verified": {
      "type": "boolean"
    },
    "acceptance_criteria_state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "satisfied"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "satisfied": { "type": "boolean" }
        }
      }
    },
    "commit_sha": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "model_tier": {
      "type": "string",
      "enum": ["flash", "neon", "argon", "human"]
    },
    "agent_runtime": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "envelope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
