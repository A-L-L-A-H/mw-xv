{
  "name": "@moonwitness/ai-runtime",
  "version": "1.0.0-rc.1",
  "description": "Typed AI provider abstraction, data-classification routing, and agent runtime for MoonWitness",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canonical-json.js": {
      "types": "./dist/canonical-json.d.ts",
      "import": "./dist/canonical-json.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "tsc -p tsconfig.check.json && vitest run"
  },
  "dependencies": {
    "@moonwitness/orm-integration": "workspace:*",
    "@moonwitness/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "~5.7.3",
    "vitest": "^5.0.3"
  }
}
