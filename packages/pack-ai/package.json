{
  "name": "@moonwitness/pack-ai",
  "version": "1.0.0-rc.1",
  "description": "Consolidated AI addon pack for MoonWitness ORM",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.check.json && vitest run"
  },
  "dependencies": {
    "@moonwitness/orm-a2a": "workspace:*",
    "@moonwitness/orm-ai": "workspace:*",
    "@moonwitness/orm-automation-core": "workspace:*",
    "@moonwitness/orm-base": "workspace:*",
    "@moonwitness/orm-bot-orchestrator": "workspace:*",
    "@moonwitness/orm-observability": "workspace:*",
    "@moonwitness/orm-storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "~5.7.3",
    "vitest": "5.0.3"
  },
  "private": true
}
