#!/usr/bin/env bash
set -euo pipefail

# Local pre-push gate: fast, proportional, diff-scoped static checks.
# Heavy gates (full typecheck, full lint, unit tests, docs build, e2e) run
# exclusively in CI; the promotion policy gate protects main.
# Set PRE_PUSH_FULL=1 to force all static buckets locally.

resolve_changed_files() {
  if [[ "${PRE_PUSH_FULL:-0}" == "1" ]]; then
    return 1
  fi

  local base_ref=""
  if upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
    base_ref="$upstream"
  elif git rev-parse --verify --quiet origin/dev >/dev/null 2>&1; then
    base_ref="origin/dev"
  elif git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
    base_ref="origin/main"
  elif git rev-parse --verify --quiet HEAD~1 >/dev/null 2>&1; then
    base_ref="HEAD~1"
  else
    return 1
  fi

  git diff --name-only "${base_ref}...HEAD" 2>/dev/null || return 1
}

matches_scope() {
  local pattern="$1"
  if [[ "$RUN_ALL" == "1" ]]; then
    return 0
  fi
  printf '%s\n' "$CHANGED_FILES" | grep -Eq "$pattern"
}

RUN_ALL=0
CHANGED_FILES=""
if ! CHANGED_FILES="$(resolve_changed_files)"; then
  RUN_ALL=1
fi

ran=()
skipped=()

if [[ "$RUN_ALL" == "0" && -z "$CHANGED_FILES" ]]; then
  echo "Fast static pre-push gates: no file diff against base; skipped."
  exit 0
fi

echo "Running proportional diff-scoped static gates before push..."

# Shared UI boundaries (static AST scanners)
if matches_scope '^(apps/(board|desktop|ui-catalog)/|packages/(ui|assets)/|scripts/check-(board-shared-ui|desktop-non-overlap|ui-design-system|ui-gate-wiring)|package\.json$)'; then
  bun run board:ui:check
  bun run desktop:ui:check
  bun run ui:design:check
  ran+=("ui")
else
  skipped+=("ui")
fi

# Addon/agent boundaries
if matches_scope '^(apps/api/|packages/(mcp-moonwitness|orm)|plugins/moonwitness/|scripts/check-(api-addon-boundary|addon-agent-boundary))'; then
  bun run api:addon:check
  bun run agent:boundary:check
  ran+=("boundaries")
else
  skipped+=("boundaries")
fi

# Automation & secret-scan hygiene (static)
if matches_scope '^(\.github/|\.gitleaks|scripts/check-(action-pins|action-tag-pins|gitleaks-config))'; then
  node scripts/check-action-pins.mjs
  node scripts/check-action-tag-pins.mjs
  node scripts/check-gitleaks-config.mjs
  ran+=("automation")
else
  skipped+=("automation")
fi

# Docs, roadmap & task registry (static)
if matches_scope '^(docs/|tasks/|\.plan/|ROADMAP\.md$|README\.md$|scripts/(check-docs|roadmap/|tasks/))'; then
  node scripts/check-docs.mjs
  node scripts/roadmap/validate-roadmap.mjs
  node scripts/tasks/validate-tasks.mjs
  ran+=("docs-tasks")
else
  skipped+=("docs-tasks")
fi

echo "Proportional pre-push gates passed (ran: ${ran[*]:-none}; skipped: ${skipped[*]:-none}). Heavy checks run in CI."
