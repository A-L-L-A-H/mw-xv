#!/usr/bin/env sh
set -eu

echo "Running shared UI design, desktop, lint, API addon boundary, and typecheck gates before push..."
bun run ui:check
bun run lint:ui
bun run api:addon:check
bun run agent:boundary:check
bun --filter @moonwitness/board typecheck
bun --filter @moonwitness/desktop typecheck:web

echo "Running fast CI-parity checks before push..."
node scripts/check-action-pins.mjs
node scripts/check-action-tag-pins.mjs
node scripts/check-gitleaks-config.mjs
node scripts/check-docs.mjs
node scripts/roadmap/validate-roadmap.mjs
node scripts/tasks/validate-tasks.mjs
node scripts/evolution/check-constitution.mjs

echo "Running fast unit tests (CI parity)..."
bun run test:unit:ci
